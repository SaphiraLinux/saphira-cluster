#!/sbin/openrc-run

description="Slurm controller daemon"

command="/usr/sbin/slurmctld"
# Foreground: supervise-daemon tracks the process directly.
command_args="-D"
# The controller cannot run without the live configuration that
# saphira-cluster generates on the target.
required_files="/etc/slurm/slurm.conf"

depend()
{
	use net logger dns
}

start_pre()
{
	checkpath -d -m 0755 -o slurm:slurm /var/spool/slurmctld
	checkpath -d -m 0755 -o slurm:slurm /var/log/slurm
}
